            "widgets_values": [
              "#version 300 es\nprecision highp float;\n\nuniform sampler2D u_image0;\nuniform vec2 u_resolution;\n\nin vec2 v_texCoord;\nlayout(location = 0) out vec4 fragColor0;\n\nvoid main() {\n    vec2 texelSize = 1.0 / u_resolution;\n    \n    // Получаем цвета соседних пикселей\n    vec4 top_left  = texture(u_image0, v_texCoord + vec2(-1.0,  1.0) * texelSize);\n    vec4 top_mid   = texture(u_image0, v_texCoord + vec2( 0.0,  1.0) * texelSize);\n    vec4 top_right = texture(u_image0, v_texCoord + vec2( 1.0,  1.0) * texelSize);\n    \n    vec4 mid_left  = texture(u_image0, v_texCoord + vec2(-1.0,  0.0) * texelSize);\n    vec4 center    = texture(u_image0, v_texCoord + vec2( 0.0,  0.0) * texelSize);\n    vec4 mid_right = texture(u_image0, v_texCoord + vec2( 1.0,  0.0) * texelSize);\n    \n    vec4 bot_left  = texture(u_image0, v_texCoord + vec2(-1.0, -1.0) * texelSize);\n    vec4 bot_mid   = texture(u_image0, v_texCoord + vec2( 0.0, -1.0) * texelSize);\n    vec4 bot_right = texture(u_image0, v_texCoord + vec2( 1.0, -1.0) * texelSize);\n    \n    // Матрица резкости (Sharpen Kernel) с силой ~10%\n    // Сумма всех коэффициентов строго равна 1.0, чтобы не менять общую яркость\n    vec4 sharpened = center * 1.8 \n                   - top_mid * 0.1 - bot_mid * 0.1 - mid_left * 0.1 - mid_right * 0.1\n                   - top_left * 0.1 - top_right * 0.1 - bot_left * 0.1 - bot_right * 0.1;\n                   \n    fragColor0 = clamp(sharpened, 0.0, 1.0);\n}\n",
              "from_input"
            ],
            "widgets_values_named": {
              "fragment_shader": "#version 300 es\nprecision highp float;\n\nuniform sampler2D u_image0;\nuniform vec2 u_resolution;\n\nin vec2 v_texCoord;\nlayout(location = 0) out vec4 fragColor0;\n\nvoid main() {\n    vec2 texelSize = 1.0 / u_resolution;\n    \n    // Получаем цвета соседних пикселей\n    vec4 top_left  = texture(u_image0, v_texCoord + vec2(-1.0,  1.0) * texelSize);\n    vec4 top_mid   = texture(u_image0, v_texCoord + vec2( 0.0,  1.0) * texelSize);\n    vec4 top_right = texture(u_image0, v_texCoord + vec2( 1.0,  1.0) * texelSize);\n    \n    vec4 mid_left  = texture(u_image0, v_texCoord + vec2(-1.0,  0.0) * texelSize);\n    vec4 center    = texture(u_image0, v_texCoord + vec2( 0.0,  0.0) * texelSize);\n    vec4 mid_right = texture(u_image0, v_texCoord + vec2( 1.0,  0.0) * texelSize);\n    \n    vec4 bot_left  = texture(u_image0, v_texCoord + vec2(-1.0, -1.0) * texelSize);\n    vec4 bot_mid   = texture(u_image0, v_texCoord + vec2( 0.0, -1.0) * texelSize);\n    vec4 bot_right = texture(u_image0, v_texCoord + vec2( 1.0, -1.0) * texelSize);\n    \n    // Матрица резкости (Sharpen Kernel) с силой ~10%\n    // Сумма всех коэффициентов строго равна 1.0, чтобы не менять общую яркость\n    vec4 sharpened = center * 1.8 \n                   - top_mid * 0.1 - bot_mid * 0.1 - mid_left * 0.1 - mid_right * 0.1\n                   - top_left * 0.1 - top_right * 0.1 - bot_left * 0.1 - bot_right * 0.1;\n                   \n    fragColor0 = clamp(sharpened, 0.0, 1.0);\n}\n",
              "size_mode": "from_input"
            }
